# Copy to .env.local for local development. Never commit real values.

# Browser-safe values (Supabase anon/publishable key only, never a service_role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only values for the Netlify function: set these in Netlify, not in VITE_* variables
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# SARVAM_API_KEY=
# SARVAM_VOICE_ID=

# GitHub Actions secrets for the LinkedIn sync (set in the repo settings, not here)
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:person:...
